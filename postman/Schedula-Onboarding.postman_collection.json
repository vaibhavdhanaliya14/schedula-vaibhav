{
  "info": {
    "name": "Schedula - Doctor & Patient Onboarding",
    "description": "Day 3 internship APIs: auth, doctor profile, patient profile, role protection, edge cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "doctorToken", "value": "" },
    { "key": "patientToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Signup Doctor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor1@test.com\",\n  \"pass\": \"password123\",\n  \"role\": \"DOCTOR\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup"
          }
        },
        {
          "name": "Signup Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient1@test.com\",\n  \"pass\": \"password123\",\n  \"role\": \"PATIENT\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup"
          }
        },
        {
          "name": "Login Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('doctorToken', res.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor1@test.com\",\n  \"pass\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('patientToken', res.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient1@test.com\",\n  \"pass\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Doctor Profile",
      "item": [
        {
          "name": "Create Doctor Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Jane Smith\",\n  \"specialization\": \"Cardiology\",\n  \"experience\": 8,\n  \"qualification\": \"MD, DM Cardiology\",\n  \"consultationFee\": 500,\n  \"availability\": \"Mon-Fri 10:00-17:00\",\n  \"profileDetails\": \"Heart specialist\"\n}"
            },
            "url": "{{baseUrl}}/doctor/profile"
          }
        },
        {
          "name": "Get Doctor Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": "{{baseUrl}}/doctor/profile"
          }
        },
        {
          "name": "Update Doctor Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultationFee\": 750,\n  \"availability\": \"Mon-Sat 09:00-18:00\"\n}"
            },
            "url": "{{baseUrl}}/doctor/profile"
          }
        }
      ]
    },
    {
      "name": "3. Patient Profile",
      "item": [
        {
          "name": "Create Patient Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"age\": 28,\n  \"gender\": \"Male\",\n  \"contactDetails\": \"+91-9876543210\",\n  \"basicHealthInformation\": \"No known allergies\"\n}"
            },
            "url": "{{baseUrl}}/patient/profile"
          }
        },
        {
          "name": "Get Patient Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/patient/profile"
          }
        },
        {
          "name": "Update Patient Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 29,\n  \"contactDetails\": \"+91-9123456789\"\n}"
            },
            "url": "{{baseUrl}}/patient/profile"
          }
        }
      ]
    },
    {
      "name": "4. Edge Cases",
      "item": [
        {
          "name": "Duplicate Doctor Profile (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Jane Smith\",\n  \"specialization\": \"Cardiology\",\n  \"experience\": 8,\n  \"qualification\": \"MD\",\n  \"consultationFee\": 500,\n  \"availability\": \"Mon-Fri 10:00-17:00\"\n}"
            },
            "url": "{{baseUrl}}/doctor/profile"
          }
        },
        {
          "name": "Doctor accessing Patient API (expect 403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": "{{baseUrl}}/patient/profile"
          }
        },
        {
          "name": "Patient accessing Doctor API (expect 403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/doctor/profile"
          }
        },
        {
          "name": "No Token (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/doctor/profile"
          }
        },
        {
          "name": "Missing Required Fields (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Incomplete\"\n}"
            },
            "url": "{{baseUrl}}/doctor/profile"
          }
        },
        {
          "name": "Invalid Extra Fields (expect 400)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultationFee\": 800,\n  \"userId\": 999,\n  \"id\": 1\n}"
            },
            "url": "{{baseUrl}}/doctor/profile"
          }
        },
        {
          "name": "Empty Update Body (expect 400)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/doctor/profile"
          }
        }
      ]
    }
  ]
}
