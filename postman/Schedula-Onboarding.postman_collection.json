{
  "info": {
    "name": "Schedula - Scheduling & Appointment APIs",
    "description": "Relevant backend APIs for auth, profiles, scheduling, booking, cancellation, and rescheduling workflows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "doctorToken", "value": "" },
    { "key": "patientToken", "value": "" },
    { "key": "doctorId", "value": "1" },
    { "key": "scheduleId", "value": "1" },
    { "key": "appointmentId", "value": "1" },
    { "key": "availabilityId", "value": "" },
    { "key": "customAvailabilityId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Signup Doctor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor1@test.com\",\n  \"pass\": \"password123\",\n  \"role\": \"DOCTOR\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup"
          }
        },
        {
          "name": "Signup Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient1@test.com\",\n  \"pass\": \"password123\",\n  \"role\": \"PATIENT\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup"
          }
        },
        {
          "name": "Login Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('doctorToken', res.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor1@test.com\",\n  \"pass\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('patientToken', res.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient1@test.com\",\n  \"pass\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Profiles",
      "item": [
        {
          "name": "Create Doctor Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('doctorId', String(res.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dr. Jane Smith\",\n  \"specialization\": \"Cardiology\",\n  \"experience\": 8,\n  \"qualification\": \"MD, DM Cardiology\",\n  \"consultationFee\": 500,\n  \"availability\": \"Mon-Fri 10:00-17:00\",\n  \"profileDetails\": \"Heart specialist\"\n}"
            },
            "url": "{{baseUrl}}/doctor/profile"
          }
        },
        {
          "name": "Get Doctor Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": "{{baseUrl}}/doctor/profile"
          }
        },
        {
          "name": "Create Patient Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"age\": 28,\n  \"gender\": \"Male\",\n  \"contactDetails\": \"+91-9876543210\",\n  \"basicHealthInformation\": \"No known allergies\"\n}"
            },
            "url": "{{baseUrl}}/patient/profile"
          }
        },
        {
          "name": "Get Patient Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/patient/profile"
          }
        }
      ]
    },
    {
      "name": "3. Scheduling",
      "item": [
        {
          "name": "Create Stream Schedule",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.scheduleId) {",
                  "  pm.collectionVariables.set('scheduleId', String(res.scheduleId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schedulingType\": \"STREAM\",\n  \"startAt\": \"2100-01-01T10:00:00.000Z\",\n  \"endAt\": \"2100-01-01T12:00:00.000Z\",\n  \"slotDurationMinutes\": 15,\n  \"bufferTimeMinutes\": 5\n}"
            },
            "url": "{{baseUrl}}/scheduling/doctor/schedules"
          }
        },
        {
          "name": "Create Wave Schedule",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schedulingType\": \"WAVE\",\n  \"startAt\": \"2100-01-02T09:00:00.000Z\",\n  \"endAt\": \"2100-01-02T11:00:00.000Z\",\n  \"maxPatients\": 5\n}"
            },
            "url": "{{baseUrl}}/scheduling/doctor/schedules"
          }
        },
        {
          "name": "Get Doctor Availability",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/scheduling/doctors/{{doctorId}}/availability"
          }
        }
      ]
    },
    {
      "name": "4. Doctor Availability",
      "item": [
        {
          "name": "Create Monday Recurring Slot",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('availabilityId', res.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": \"MONDAY\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"13:00\"\n}"
            },
            "url": "{{baseUrl}}/doctor/availability"
          }
        },
        {
          "name": "Create Monday Second Slot",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": \"MONDAY\",\n  \"startTime\": \"15:00\",\n  \"endTime\": \"17:00\"\n}"
            },
            "url": "{{baseUrl}}/doctor/availability"
          }
        },
        {
          "name": "Get Recurring Availability",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": "{{baseUrl}}/doctor/availability"
          }
        },
        {
          "name": "Update Recurring Availability",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"09:00\",\n  \"endTime\": \"12:00\"\n}"
            },
            "url": "{{baseUrl}}/doctor/availability/{{availabilityId}}"
          }
        },
        {
          "name": "Create Custom Override",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('customAvailabilityId', res.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-06-15\",\n  \"startTime\": \"14:00\",\n  \"endTime\": \"15:00\"\n}"
            },
            "url": "{{baseUrl}}/doctor/availability/override"
          }
        },
        {
          "name": "Get Availability For Date",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": "{{baseUrl}}/doctor/availability/date?date=2026-06-15"
          }
        }
      ]
    },
    {
      "name": "5. Appointments & Edge Cases",
      "item": [
        {
          "name": "Book Stream Appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.appointmentId) {",
                  "  pm.collectionVariables.set('appointmentId', String(res.appointmentId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduleId\": {{scheduleId}},\n  \"slotStartAt\": \"2100-01-01T10:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/scheduling/patient/bookings"
          }
        },
        {
          "name": "Get My Appointments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/scheduling/patient/appointments"
          }
        },
        {
          "name": "Get Doctor Appointments",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": "{{baseUrl}}/scheduling/doctor/appointments"
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/scheduling/appointments/{{appointmentId}}/cancel"
          }
        },
        {
          "name": "Reschedule Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduleId\": {{scheduleId}},\n  \"slotStartAt\": \"2100-01-01T10:15:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/scheduling/appointments/{{appointmentId}}/reschedule"
          }
        },
        {
          "name": "Overlapping Availability With Existing Slot (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": \"MONDAY\",\n  \"startTime\": \"15:30\",\n  \"endTime\": \"16:30\"\n}"
            },
            "url": "{{baseUrl}}/doctor/availability"
          }
        },
        {
          "name": "Duplicate Existing Slot (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": \"MONDAY\",\n  \"startTime\": \"15:00\",\n  \"endTime\": \"17:00\"\n}"
            },
            "url": "{{baseUrl}}/doctor/availability"
          }
        },
        {
          "name": "Invalid Time Range (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": \"TUESDAY\",\n  \"startTime\": \"15:00\",\n  \"endTime\": \"13:00\"\n}"
            },
            "url": "{{baseUrl}}/doctor/availability"
          }
        },
        {
          "name": "Invalid Date (expect 400)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": "{{baseUrl}}/doctor/availability/date?date=2026-02-31"
          }
        },
        {
          "name": "Unavailable Date (expect 404)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": "{{baseUrl}}/doctor/availability/date?date=2026-06-16"
          }
        },
        {
          "name": "Patient Accessing Doctor Availability (expect 403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{patientToken}}" }
            ],
            "url": "{{baseUrl}}/doctor/availability"
          }
        },
        {
          "name": "Delete Custom Override Cleanup (expect 200)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": "{{baseUrl}}/doctor/availability/override/{{customAvailabilityId}}"
          }
        },
        {
          "name": "Delete Recurring Availability Cleanup (expect 200)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" }
            ],
            "url": "{{baseUrl}}/doctor/availability/{{availabilityId}}"
          }
        }
      ]
